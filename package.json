{
  "name": "convectivity-helpers-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_TILES_BASE=data/ vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "styles": "node scripts/qml_to_styles.mjs",
    "percentiles": "python3 scripts/make_percentiles.py",
    "tiles": "bash scripts/build_tiles.sh",
    "tiles:publish": "bash scripts/publish_tiles.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.20",
    "maplibre-gl": "^4.5.0",
    "marked": "^12.0.2",
    "pmtiles": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^4.5.3"
  }
}
